# Server Configuration
PORT=3001
NODE_ENV=development

# ===================================================
# 1. AI VOICE CALL API (Choose one: Bland.ai or Vapi)
# ===================================================
# Bland.ai (https://bland.ai)
BLAND_AI_API_KEY=your_bland_ai_api_key_here
BLAND_AI_PHONE_NUMBER=+1XXXXXXXXXX

# OR Vapi (https://vapi.ai)
VAPI_API_KEY=your_vapi_api_key_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# ===================================================
# 2. ANONYMOUS SMS RELAY API (Twilio)
# ===================================================
# Twilio (https://www.twilio.com/console)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PROXY_NUMBER=+1XXXXXXXXXX

# ===================================================
# 3. CONTENT MODERATION (Optional - OpenAI)
# ===================================================
OPENAI_API_KEY=your_openai_api_key_here
