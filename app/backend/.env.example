# Server Configuration
PORT=3001
NODE_ENV=development
# For persistent hosting, set this to the container path for mounted storage.
# AWS Compose uses /var/data and persists it on the host's EBS mount.
WHATSAPP_AUTH_PATH=
# Optional; set when Chromium is not installed at its platform default.
PUPPETEER_EXECUTABLE_PATH=

# ===================================================
# 1. AI VOICE CALL API (Choose one: Bland.ai or Vapi)
# ===================================================
# Bland.ai (https://bland.ai)
BLAND_AI_API_KEY=your_bland_ai_api_key_here
BLAND_AI_PHONE_NUMBER=+1XXXXXXXXXX

# OR Vapi (https://vapi.ai)
VAPI_API_KEY=your_vapi_api_key_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# WhatsApp alerts use the local WhatsApp Web client and a persistent QR-linked session.
# Start the backend and scan the QR code printed to its terminal on first run.

# ===================================================
# 2. TELEGRAM BOT API (https://t.me/BotFather)
# ===================================================
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather_here
# Optional; if blank, the backend discovers the username with Telegram getMe.
TELEGRAM_BOT_USERNAME=
# Set the deployed public URL and a random Telegram-compatible secret to enable webhook pairing.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Firebase Admin credentials (required by the backend for Telegram pairing and dispatch)
FIREBASE_PROJECT_ID=callmycar-c3e30
# Required in production for POST /api/assistant-report. Configure the same value as
# X-Assistant-Webhook-Secret in Dialogflow/IFTTT webhook settings.
# Set FIREBASE_SERVICE_ACCOUNT_JSON to the full service-account JSON on one line.
# Local Google Application Default Credentials are also supported.

# ===================================================
# 3. CONTENT MODERATION (Optional - OpenAI)
# ===================================================
OPENAI_API_KEY=your_openai_api_key_here
