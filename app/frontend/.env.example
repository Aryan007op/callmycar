# Firebase browser configuration. These values are public in a browser build;
# use Firebase security rules, API restrictions, and App Check to protect data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional backend base URL for production deployments.
VITE_BACKEND_URL=
